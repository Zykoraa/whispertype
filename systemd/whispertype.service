[Unit]
Description=WhisperType Instant Voice Dictation Daemon
After=pipewire.service sound.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/eve/Projects/whispertype/.venv/bin/whispertyped
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/eve/.local/bin:/usr/local/bin:/usr/bin
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE DISPLAY

[Install]
WantedBy=default.target
